{
  "name": "@luxass/spectral-ruleset",
  "version": "1.1.2",
  "description": "Opinonated ruleset for Spectral",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luxass/spectral-ruleset.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/ruleset.cjs",
  "module": "./dist/ruleset.mjs",
  "exports": {
    ".": {
      "import": "./dist/ruleset.mjs",
      "require": "./dist/ruleset.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@stoplight/spectral-formats": "catalog:spectral",
    "@stoplight/spectral-functions": "catalog:spectral",
    "@stoplight/spectral-rulesets": "catalog:spectral"
  },
  "devDependencies": {
    "@stoplight/spectral-core": "catalog:spectral",
    "@stoplight/spectral-ref-resolver": "catalog:spectral",
    "@stoplight/types": "catalog:spectral",
    "@types/node": "catalog:types",
    "oxfmt": "catalog:dev",
    "oxlint": "catalog:dev",
    "publint": "catalog:dev",
    "tsdown": "catalog:dev",
    "typescript": "catalog:dev",
    "vitest": "catalog:test"
  },
  "packageManager": "pnpm@12.21.0"
}
